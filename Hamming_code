class Num:
    def __init__(self, arr):
        self.arr = arr

    @staticmethod
    def is_valid(number):
        if number != 0 and number != 1:
            print("Try again, Binary only idiot")
            return -1
        return number
            
    def no_parity(self):
        m = len(self.arr)
        r = 0
        while True:
            if 2 ** r >= m + r + 1:
                return r
            r += 1
            
    def hamming(self, p_bits):
        m = len(self.arr)
        n_size = m + p_bits
        ans_arr = [0] * n_size
        
        for x in range(p_bits):
            ans_arr[(2**x) - 1] = 'P'
            
        data_index = 0
        for i in range(n_size):
            if ans_arr[i] != 'P':
                ans_arr[i] = self.arr[data_index]
                data_index += 1
                
        return ans_arr

size = int(input("Take no. of binary digits to enter: "))
arr = []

print(f"Please enter {size} binary digits (0 or 1) one by one:")
while len(arr) < size:
    try:
        user_input = int(input(f"Enter bit {len(arr) + 1}: "))
        if Num.is_valid(user_input) != -1:
            arr.append(user_input)
    except ValueError:
        print("Please enter a valid integer.")

binary_num = Num(arr)
print("\nSuccessfully created binary array:")
for x in binary_num.arr:
    print(x, end=" ")
print("\n")

p_bits = binary_num.no_parity()
print(f"No. of Parity bits will be {p_bits}")

hamming_structure = binary_num.hamming(p_bits)
print("Hamming Frame Structure (P = Parity Placeholder):")
print(hamming_structure)
